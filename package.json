    "prismjs": "^1.29.0",
    "prop-types": "^15.8.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-helmet": "^6.1.0",
    "react-share": "^4.4.1",
    "react-toggle": "^4.1.3",
